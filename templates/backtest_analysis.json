{
  "name": "回测分析模板",
  "description": "策略回测完整流程：行情数据（本地缓存）→ 因子信号 → 回测执行 → 结果输出",
  "nodes": [
    {
      "uuid": "n1",
      "name": "QMTKlineNode",
      "title": "行情数据(本地缓存)",
      "positionX": 50,
      "positionY": 100,
      "width": 240,
      "height": 180,
      "static_input_data": { "period": "1d", "start_date": "20230101" }
    },
    {
      "uuid": "n2",
      "name": "FactorFormulaNode",
      "title": "信号公式",
      "positionX": 350,
      "positionY": 100,
      "width": 240,
      "height": 180,
      "static_input_data": {
        "formula": "RANK(close / DELAY(close, 5) - 1)",
        "start_date": "20230101"
      }
    },
    {
      "uuid": "n3",
      "name": "BacktestNode",
      "title": "回测引擎",
      "positionX": 650,
      "positionY": 100,
      "width": 240,
      "height": 180,
      "static_input_data": {
        "initial_capital": 1000000,
        "commission_rate": 0.001,
        "slippage": 0.001
      }
    },
    {
      "uuid": "n4",
      "name": "OutputNode",
      "title": "结果输出",
      "positionX": 950,
      "positionY": 100,
      "width": 240,
      "height": 180,
      "static_input_data": { "output_name": "backtest_result", "format": "table" }
    }
  ],
  "links": [
    {
      "uuid": "l1",
      "previous_node_uuid": "n2",
      "output_field_name": "factor_data",
      "next_node_uuid": "n3",
      "input_field_name": "signals"
    },
    {
      "uuid": "l2",
      "previous_node_uuid": "n1",
      "output_field_name": "close",
      "next_node_uuid": "n3",
      "input_field_name": "prices"
    },
    {
      "uuid": "l3",
      "previous_node_uuid": "n1",
      "output_field_name": "volume",
      "next_node_uuid": "n3",
      "input_field_name": "volume"
    },
    {
      "uuid": "l4",
      "previous_node_uuid": "n1",
      "output_field_name": "high",
      "next_node_uuid": "n3",
      "input_field_name": "high"
    },
    {
      "uuid": "l5",
      "previous_node_uuid": "n1",
      "output_field_name": "low",
      "next_node_uuid": "n3",
      "input_field_name": "low"
    },
    {
      "uuid": "l6",
      "previous_node_uuid": "n3",
      "output_field_name": "equity_curve",
      "next_node_uuid": "n4",
      "input_field_name": "data"
    }
  ]
}
